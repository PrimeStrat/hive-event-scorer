{
    "name": "hive-event-scorer",
    "version": "1.1.0",
    "description": "Automated scoring for Hive Minecraft events with live chat log capture using 3rd party chat loggers",
    "main": "src/Main.js",
    "author": "PrimeStrat",
    "license": "MIT",
    "contributors": [
        {
            "name": "SandRosey",
            "url": "https://github.com/Sand2075"
        }
    ],
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win",
        "release": "node Scripts/Release.js"
    },
    "devDependencies": {
        "electron": "^31.0.0",
        "electron-builder": "^24.13.3"
    },
    "build": {
        "appId": "com.primestrat.hive-event-scorer",
        "productName": "Hive Event Scorer",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*"
        ],
        "extraResources": [
            {
                "from": "PresetSettings",
                "to": "PresetSettings"
            }
        ],
        "win": {
            "icon": "src/Assets/Icon.ico",
            "target": [
                "portable",
                "nsis"
            ]
        }
    },
    "allowScripts": {
        "electron@31.7.7": true
    }
}
